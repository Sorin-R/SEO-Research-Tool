{
  "name": "seo-research-tool-backend",
  "version": "1.0.0",
  "description": "Personal SEO research tool - backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --watch . --ext js,mjs,cjs,json --ignore \"data/runtime-store.json\" --ignore \"data/*.json\" --exec \"node server.js\"",
    "local-serp-agent": "node scripts/localSerpAgent.js"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-ads-api": "^23.0.0",
    "google-trends-api": "^4.9.2",
    "mysql2": "^3.10.1",
    "node-cron": "^3.0.3"
  },
  "optionalDependencies": {
    "puppeteer": "^22.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
