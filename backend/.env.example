# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=seo_tool
DB_PORT=3306

# Server
PORT=3001

# Scraping
SCRAPE_DELAY_MS=2000
MAX_CONCURRENT_SCRAPES=2

# Rank Tracker - set this to your domain to track rankings
TARGET_DOMAIN=

# Google Ads API (optional)
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_customer_id

# SERP API Providers (choose at least one)
# The system will try providers in this order and automatically fallback
# All offer free tiers with 100+ searches/month
# See SERP_API_SETUP.md for detailed setup instructions

# 1. SerpAPI (FREE: 100/month) - https://serpapi.com/
SERPAPI_KEY=

# 2. Serpstack (FREE: 100/month) - https://serpstack.com/
SERPSTACK_KEY=

# 3. Zenserp (FREE: 100/month) - https://zenserp.com/
ZENSERP_KEY=

# 4. SearchAPI (FREE: 100/month) - https://www.searchapi.io/
SEARCHAPI_KEY=

# 5. ScaleSERP (FREE: 100/month) - https://www.scaleserp.com/
SCALESERP_KEY=

# 6. Google Custom Search (FREE: 100/day) - https://programmablesearchengine.google.com/
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# 7. Bing Search API (FREE: ~1000/month) - https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
BING_SEARCH_KEY=
